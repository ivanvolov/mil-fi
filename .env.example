# mil-fi — repo-root env template. Copy to `.env` for local dev.
#
# Secrets are canonically stored in Infisical (EU, https://eu.infisical.com):
#   project  "HOC"  id=1c02be0d-3fed-4e98-aa38-d02f4eb3a03b
#   env      dev
#   folders  /mil-fi            ← this file (platform server)
#            /mil-fi/verification      ← verification/.env
#            /mil-fi/platform-server   ← platform/server/.env
#            /mil-fi/app               ← app/my-first-mini-app/.env.local
#
# Fastest way to fill this file — pull the secret values straight from Infisical
# and paste them over the blank lines below:
#   infisical export --projectId 1c02be0d-3fed-4e98-aa38-d02f4eb3a03b \
#     --env dev --path /mil-fi --format dotenv

# ─── Infisical service token — THIS is where it goes ─────────────────────────
# Dashboard → project HOC → Access Control → Service Tokens → create one scoped
# to env=dev, path=/mil-fi (read). Paste it:
#   · on Render: dashboard env var INFISICAL_TOKEN (the ONLY secret Render needs;
#     `npm run start:infisical` in platform/ injects everything else at boot)
#   · locally: only needed for `infisical export`/`run` via token auth — normal
#     `infisical login` works too, then you don't need a token at all.
INFISICAL_TOKEN=
# EU cloud — the CLI reads this automatically (default is the US endpoint).
INFISICAL_API_URL=https://eu.infisical.com/api
INFISICAL_PROJECT_ID=1c02be0d-3fed-4e98-aa38-d02f4eb3a03b
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/mil-fi

# ─── Non-secret local-only config (not in Infisical: `infisical run` overrides
#     real env vars, and Render must control PORT) ───────────────────────────
MONGODB_DB=milfy-app
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ─── Secrets (Infisical env=dev folder=/mil-fi) ──────────────────────────────
MONGODB_URI=
# Auth — required in production (>=32 chars). Generate: openssl rand -base64 32
SESSION_SECRET=
OPENAI_API_KEY=
RENDER_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 0G Compute Router (OpenAI-compatible)
OG_API_KEY=
OG_API_KEY_TEE=
ZG_ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_ROUTER_API_KEY=
ZG_MODEL=qwen2.5-omni

# Hedera testnet — create an account at https://portal.hedera.com, paste id + key.
# Then run `npm run hedera:setup` in platform/server and paste the printed ids.
HEDERA_NETWORK=testnet
HEDERA_KEY_TYPE=ECDSA
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_DEFPOINT_TOKEN_ID=
HEDERA_EVIDENCE_TOPIC_ID=

# World integration (docs/05-integration-contract.md). Leave blank for demo mode.
# NOTE: WORLD_BASE_URL pointed at the old Vercel deploy (mil-fi.vercel.app) —
# repoint at the Render URL once the Vercel project is deleted.
WORLD_BASE_URL=
WORLD_SERVICE_TOKEN=
WORLD_SIGNER_ADDRESS=
# World ID one-time verification gate (platform/server/src/auth/worldVerify.ts).
# Same Developer Portal app as app/my-first-mini-app/.env.local.
RP_ID=
VITE_WORLD_APP_ID=
RP_SIGNING_KEY=
# staging = verification via the simulator link under the QR; flip to
# `production` once World ID 4.0 is GA in World App.
VITE_WORLD_ENV=staging

# World AgentKit — claim-agent identity (no funds; signs payout claims).
AGENT_WALLET_KEY=
