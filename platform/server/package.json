{
  "name": "orchestration-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:specs": "tsx src/scripts/syncSpecs.ts",
    "migrate:fields": "tsx src/scripts/migrateFields.ts",
    "seed:invites": "tsx src/scripts/seedInvites.ts",
    "seed:roles": "tsx src/scripts/seedRoleInvites.ts",
    "seed:users": "tsx src/scripts/seedUsers.ts",
    "backup:layers": "tsx src/scripts/backupAllLayers.ts",
    "refresh-db": "tsx src/scripts/refreshStagingDb.ts",
    "hedera:setup": "tsx src/scripts/hederaSetup.ts",
    "hedera:smoke": "tsx src/scripts/hederaSmoke.ts",
    "verify:smoke": "tsx src/scripts/verifySmoke.ts",
    "token:smoke": "tsx src/scripts/tokenSmoke.ts",
    "engagement:smoke": "tsx src/scripts/engagementSmoke.ts",
    "world:smoke": "tsx src/scripts/worldSmoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@hashgraph/sdk": "^2.81.0",
    "@worldcoin/idkit": "^4.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "mongodb": "^6.12.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "viem": "^2.55.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
