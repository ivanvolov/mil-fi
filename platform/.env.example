# Non-secret runtime config
MONGODB_DB=milfy-app
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Secrets — plain env vars, no secret manager.
# Copy this file to the REPO ROOT as `.env` (MilFi/.env) — the one shared env
# file for all apps in this repo. Real environment variables always win over it.
MONGODB_URI=
# Auth — required in production (>=32 chars). Dev gets an auto-generated ephemeral secret.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
OPENAI_API_KEY=
RENDER_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production-only (set by Render)
# NODE_ENV=production
# SERVE_STATIC=true
